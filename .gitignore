# ==========================================
# 1. Dados e Saídas Locais (Hospedados no Dropbox)
# ==========================================
# Ignora a pasta de dados inteira (entradas brutas e GPKGs/NetCDFs gerados)
dados/
stac_catalog/

# Proteção adicional contra arquivos geográficos pesados na raiz ou subpastas
*.gpkg
*.nc
*.tif
*.tiff
*.shp
*.dbf
*.shx
*.prj
*.cpg

# ==========================================
# 2. Arquivos Temporários e Cache do Python
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# ==========================================
# 3. Ambientes Virtuais (Virtual Environments)
# ==========================================
venv/
.venv/
env/
ENV/

# ==========================================
# 4. Configurações de IDEs (VSCode / PyCharm)
# ==========================================
.vscode/
.idea/
*.swp
*.swo

# ==========================================
# 5. Segurança e Arquivos de Sistema
# ==========================================
.env
.DS_Store
Thumbs.db
